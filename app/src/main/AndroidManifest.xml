<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 检查更新：访问 GitHub Releases API（仅用户开启「自动检查更新」或手动检查时联网） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 声明查询其他应用的 Quick Settings Tile 服务 -->
    <queries>
        <intent>
            <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent>
    </queries>

    <application
        android:name=".ExTileApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExTile">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ExTile.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DocsActivity"
            android:exported="false"
            android:label="@string/docs_title"
            android:theme="@style/Theme.ExTile" />

        <activity
            android:name=".DebugToolsActivity"
            android:exported="false"
            android:label="@string/debug_title"
            android:theme="@style/Theme.ExTile" />

        <!-- 幽灵桥接 Activity：长按 exTile 磁贴时由系统通过 ACTION_QS_TILE_PREFERENCES 启动，
             读取配置分发到目标后立即关闭，实现长按行为自定义 -->
        <activity
            android:name=".TileLongClickActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ExTile.Transparent"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Shizuku UserService：由 Shizuku 服务进程以不同 uid 绑定。
             进程名由 UserServiceArgs.processNameSuffix("command") 统一控制，
             这里不要再声明 android:process，避免与 Shizuku 的进程配置冲突。 -->
        <service
            android:name=".shizuku.CommandService"
            android:exported="true" />

        <service
            android:name=".tile.ExTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

    </application>

</manifest>
